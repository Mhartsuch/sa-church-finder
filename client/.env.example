# Copy to .env.local for local development. Every value is exposed to the
# browser bundle — never put secrets here.

# API base URL (no trailing slash). Leave empty in dev to use the Vite proxy.
VITE_API_URL=

# Public Mapbox token. Without it the map shows an "unavailable" message.
VITE_MAPBOX_TOKEN=

# Optional error monitoring (disabled when the DSN is empty).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
