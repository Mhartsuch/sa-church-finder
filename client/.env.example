# Copy to .env (or .env.local) for local development.
# All values are exposed to the browser bundle — never put secrets here.

# Base URL of the API server (no trailing slash). Local dev default shown.
VITE_API_URL=http://localhost:3001

# Mapbox GL access token (public token). Without it the map falls back to
# the SVG placeholder.
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# Error monitoring (optional). Sentry is disabled when the DSN is empty.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# Optional: Stripe payment link for the footer "Support Us" block.
# The block is hidden when this is unset.
VITE_STRIPE_DONATION_URL=

# Optional: support email shown on help pages (defaults to
# admin@sachurchfinder.com when unset).
VITE_SUPPORT_EMAIL=
