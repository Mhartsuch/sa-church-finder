# Server Configuration
NODE_ENV=development
PORT=3001

# Client Configuration
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sa_church_finder

# Session
# SESSION_SECRET is required when NODE_ENV=production (the server refuses to
# start without it). SESSION_COOKIE_SAME_SITE overrides the default cookie
# policy (lax in development, none in production); valid: lax|strict|none.
SESSION_SECRET=your-secret-key-change-in-production
SESSION_COOKIE_SAME_SITE=
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_EXPOSE_RESET_PREVIEW=false
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
AUTH_EXPOSE_VERIFICATION_PREVIEW=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# File uploads are stored on local disk under ./uploads/church-photos with a
# 10 MB per-file limit; both are currently hardcoded in
# src/routes/church-photo.routes.ts (no env vars).

# Email (for verification and notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@sachurchfinder.com

# Logging
LOG_LEVEL=info

# Monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Deployment metadata surfaced by GET /api/v1/health (optional)
APP_VERSION=
GIT_COMMIT=

# Google Maps / Places API
MAPS_API_KEY=your-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Supabase Storage (for Google import photo uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
