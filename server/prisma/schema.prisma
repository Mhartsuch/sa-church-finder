// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// Models
model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String?
  name                    String
  avatarUrl               String?
  googleId                String?                  @unique
  emailVerified           Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  reviews                 Review[]
  savedChurches           UserSavedChurch[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Church {
  id                   String                                @id @default(uuid())
  name                 String
  slug                 String                                @unique
  denomination         String?
  denominationFamily   String?
  description          String?
  address              String
  city                 String                                @default("San Antonio")
  state                String                                @default("TX")
  zipCode              String
  neighborhood         String?
  latitude             Decimal                               @db.Decimal(10, 8)
  longitude            Decimal                               @db.Decimal(11, 8)
  /// PostGIS geography point — auto-populated by DB trigger from lat/lng
  location             Unsupported("geography(Point,4326)")?
  phone                String?
  email                String?
  website              String?
  pastorName           String?
  yearEstablished      Int?
  avgRating            Decimal                               @default(0) @db.Decimal(3, 2)
  reviewCount          Int                                   @default(0)
  googleRating         Decimal?                              @db.Decimal(3, 2)
  googleReviewCount    Int?
  languages            String[]                              @default([])
  amenities            String[]                              @default([])
  coverImageUrl        String?
  googlePlaceId        String?                               @unique
  businessStatus       String?
  googleMapsUrl        String?
  primaryType          String?
  goodForChildren      Boolean?
  goodForGroups        Boolean?
  wheelchairAccessible Boolean?
  /// Hidden listings (non-churches, duplicates) are excluded from every public surface
  isHidden             Boolean                               @default(false)
  /// Why the listing is hidden: office | school | cemetery | charity | facility | residence | business | not_a_congregation | duplicate | manual
  hiddenReason         String?
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt
  services             ChurchService[]
  photos               ChurchPhoto[]
  reviews              Review[]
  savedByUsers         UserSavedChurch[]
  enrichmentState      EnrichmentState?

  @@index([slug])
  @@index([denominationFamily])
  @@index([latitude, longitude])
  @@index([isHidden])
  @@map("churches")
}

model EnrichmentState {
  id            String    @id @default(uuid())
  churchId      String    @unique
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  version       String    @default("v2")
  status        String // pending | fetched | extracted | applied | skipped_no_data | failed | rate_limited
  pagesFetched  Json      @default("[]")
  extractedData Json?
  confidence    Float?
  source        String?
  lastError     String?
  attempts      Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([status, version])
  @@map("enrichment_states")
}

model ChurchService {
  id             String   @id @default(uuid())
  churchId       String
  church         Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startTime      String
  endTime        String?
  serviceType    String
  language       String   @default("English")
  description    String?
  isAutoImported Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("church_services")
}

model ChurchPhoto {
  id             String   @id @default(uuid())
  churchId       String
  church         Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  url            String
  altText        String?
  displayOrder   Int      @default(0)
  googlePhotoRef String?
  createdAt      DateTime @default(now())

  @@map("church_photos")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  rating    Decimal  @db.Decimal(3, 2)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, churchId])
  @@map("reviews")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("email_verification_tokens")
}

model UserSavedChurch {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId String
  church   Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  savedAt  DateTime @default(now())

  @@id([userId, churchId])
  @@map("user_saved_churches")
}
